# Server Environment Variables
PORT=5000
NODE_ENV=development

# Database Configuration (Default SQLite for instant local dev, or PostgreSQL for production)
# PostgreSQL Example: DATABASE_URL="postgresql://user:password@localhost:5432/snipdesalon?schema=public"
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET="replace_with_a_secure_jwt_secret_in_production"
JWT_EXPIRES_IN="7d"

# Initial Admin Credentials (used during database seed)
ADMIN_EMAIL="admin@snipdesalon.com"
ADMIN_PASSWORD="SalonAdmin2026!"

# Payments (Razorpay Integration)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"

# Frontend Client URL (for CORS)
CLIENT_URL="http://localhost:5173"
